# PricePulseSL auth API — must be HTTP (https://api.pricepulse.lk returns 404)
API_BASE_URL=http://api.pricepulse.lk

# Same JWT settings as PricePulseSL
JWT_SECRET=
JWT_ISSUER=PricePulse
JWT_AUDIENCE=PricePulse

# Same Postgres as PricePulseSL
DATABASE_URL=postgresql://user:pass@host:5432/postgres

# S3 (same bucket conventions as PricePulseSLImage)
S3_BUCKET=pricepulsev
S3_REGION=ap-south-1
S3_PUBLIC_BASE_URL=https://pricepulsev.s3.ap-south-1.amazonaws.com
S3_KEY_PREFIX=staging/
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
